# Charger les packages nécessaires
install.packages("DBI")
install.packages("RSQLite")
library(DBI)
library(RSQLite)
# Connexion à une base SQLite (fichier .db)
con <- dbConnect(SQLite(), "ma_base.db")
# Lire le fichier SQL (doit être dans le même dossier que ce script)
sql_script <- readLines("script.sql")
# Exécuter chaque requête ligne par ligne
for (req in sql_script) {
# Ignorer les lignes vides ou commentaires
if (nchar(req) > 0 && !grepl("^--", req)) {
tryCatch({
dbExecute(con, req)
}, error = function(e) {
message("Erreur dans la requête : ", req)
message("Message : ", e$message)
})
}
}
# Vérifier les tables créées
print(dbListTables(con))
# Exemple : afficher les 5 premières lignes d'une table (remplace 'ma_table' par le nom réel)
# print(dbGetQuery(con, "SELECT * FROM ma_table LIMIT 5"))
# Fermer la connexion
dbDisconnect(con)
